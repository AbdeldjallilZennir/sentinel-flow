              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dropped_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "flow"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 360
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sentinel-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ip,\n       argMax(backend, ts_us) AS backend,\n       multiIf(argMax(action, ts_us) = 'expire', 'expired',\n               argMax(action, ts_us) = 'unblock', 'unblocked',\n               maxIf(toInt64(ts_us) + timeout_s * 1000000, action IN ('block', 'counters'))\n                 < toUnixTimestamp64Micro(now64(6)), 'expired',\n               'active') AS status,\n       argMaxIf(reason, ts_us, action = 'block') AS reason,\n       round(argMaxIf(score, ts_us, action = 'block'), 3) AS score,\n       argMaxIf(flow, ts_us, action = 'block') AS flow,\n       max(dropped_pkts) AS dropped_pkts, max(dropped_bytes) AS dropped_bytes,\n       formatDateTime(toDateTime(intDiv(minIf(ts_us, action = 'block'), 1000000), 'UTC'),\n                      '%Y-%m-%d %H:%i:%S') AS first_blocked\nFROM sentinel.mitigations\nWHERE ip != '' AND action IN ('block', 'counters', 'expire', 'unblock')\nGROUP BY ip\nORDER BY (status = 'active') DESC, dropped_pkts DESC, minIf(ts_us, action = 'block'), ip"
        }
      ]
    }
  ]
}