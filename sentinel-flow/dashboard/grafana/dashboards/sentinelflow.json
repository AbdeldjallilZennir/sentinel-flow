              "options": "score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 0.8
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "iforest"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 0.8
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "flow"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sentinel-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(src_ip, ' -> ', dst_ip, ':', toString(dst_port)) AS flow,\n       app_protocol, count() AS flows, round(max(ml_anomaly_score), 3) AS score,\n       round(max(ml_c2_proba), 3) AS c2_proba, round(max(ml_iforest_score), 3) AS iforest,\n       any(ml_model) AS model\nFROM sentinel.network_flows\nWHERE ml_anomaly_score >= 0.8\nGROUP BY src_ip, dst_ip, dst_port, app_protocol\nORDER BY score DESC, flows DESC\nLIMIT 100"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Active Kernel Mitigations & XDP Drop Counters",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sentinel-clickhouse"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dropped_pkts"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
